{
  "name": "public-market-rental-monitoring-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Public Market Rental Monitoring System — Tanauan Public Market, Market Office",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron:dev": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "electron:start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win",
    "dist:portable": "npm run build && electron-builder --win portable",
    "dist:installer": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  },
  "build": {
    "appId": "ph.gov.tanauan.publicmarket",
    "productName": "Tanauan Public Market System",
    "copyright": "Municipality of Tanauan, Leyte",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "!node_modules/@node-llama-cpp/win-x64-cuda/**",
      "!node_modules/@node-llama-cpp/win-x64-cuda-ext/**",
      "!node_modules/@node-llama-cpp/win-x64-vulkan/**",
      "!node_modules/@node-llama-cpp/win-arm64/**"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "TanauanPublicMarketSystem-Portable-${version}.exe"
    },
    "nsis": {
      "artifactName": "TanauanPublicMarketSystem-Setup-${version}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tanauan Public Market System",
      "uninstallDisplayName": "Tanauan Public Market System"
    },
    "asarUnpack": [
      "**/*.node",
      "resources/models/**"
    ],
    "extraResources": [
      {
        "from": "build/models",
        "to": "models",
        "filter": [
          "**/*.gguf"
        ]
      }
    ]
  },
  "optionalDependencies": {
    "node-llama-cpp": "^3.20.0"
  }
}
