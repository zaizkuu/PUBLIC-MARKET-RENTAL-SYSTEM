# Dependencies (restore with: npm install)
node_modules/

# Vite build output (regenerate with: npm run build)
dist/

# Packaged desktop builds (regenerate with: npm run dist)
release/

# Build metadata
*.tsbuildinfo

# Local knowledge-graph output
graphify-out/

# Environment
.env
.env.local

# Language model files for the assistant. Large binaries, fetched or copied in
# per machine; build/models/README.txt explains where they go.
*.gguf
